# Public address of the site once it is online, e.g. https://tachabeauty-invite.com
NEXT_PUBLIC_SITE_URL=

# Google Wallet (optional). Leave empty and the "Save your invitation" button saves to the calendar instead.
# Get these from https://pay.google.com/business/console and a Google Cloud service account
# that has been added to the Wallet issuer account.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the service account JSON, keeping the \n sequences.
GOOGLE_WALLET_PRIVATE_KEY=
